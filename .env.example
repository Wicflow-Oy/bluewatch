# BlueWatch settings. Copy to .env for docker compose, or to .env.local for local development (loaded
# automatically). Never commit the filled-in file. An empty value means the default in the comment.

# --- Claude (one key for this app only, in its own workspace with a spend limit)
ANTHROPIC_API_KEY=
# Model that reads company websites [claude-haiku-5-5]
BLUEWATCH_CLASSIFIER_MODEL=
# Model that writes outreach drafts [claude-sonnet-5-5]
BLUEWATCH_WRITER_MODEL=
# Let Idea Harbour ask Claude when a team opts in (1 = on; also needs ANTHROPIC_API_KEY) [0]
BLUEWATCH_IDEAS_MODEL=
# Price override per model in USD per million tokens, "input,output"; the name is the model id in
# upper case with - as _, e.g. BLUEWATCH_PRICE_CLAUDE_HAIKU_5_5=0.10,0.50 [built-in price table]

# --- Network and dates
# Serve recorded data only; no network calls except live lookups (1 = offline) [1]
BLUEWATCH_OFFLINE=
# Let the live business-ID lookup, name search and founder view call the public registers (1 = on) [0]
BLUEWATCH_LIVE_LOOKUPS=
# Pin "today" for dates and deadlines, e.g. 2026-10-17 for a recording [today in Helsinki]
BLUEWATCH_TODAY=
# The deployed commit, shown as "build" in /api/meta; set it at deploy time to git rev-parse --short HEAD [dev]
BLUEWATCH_BUILD=

# --- Public-app guards
# Public mode: never send e-mail, never store visitor input (the compose files force 1) [0]
BLUEWATCH_PUBLIC=
# Daily model spend cap in USD [40]
BLUEWATCH_DAILY_SPEND_CAP_USD=
# Live lookups per visitor IP per hour; a venue shares one IP [300]
BLUEWATCH_LOOKUPS_PER_IP_PER_HOUR=
# Live lookups in total per minute [120]
BLUEWATCH_LOOKUPS_PER_MINUTE_TOTAL=

# --- Paths
# Raw-response cache and the daily spend counter [data/cache]
BLUEWATCH_CACHE_DIR=
# Where the file outbox writes messages instead of sending them [data/outbox]
BLUEWATCH_OUTBOX_DIR=
# The built front end the API serves [frontend/dist]
BLUEWATCH_FRONTEND_DIST=
# Skip loading .env.local (1 = skip); set it in the environment, not in this file [0]
BLUEWATCH_SKIP_ENV_LOCAL=

# --- Idea Harbour storage (ignored in public mode, where shared ideas stay in memory)
# Keep shared ideas in a JSON-lines file (1 = on) [0]
BLUEWATCH_IDEAS_PERSIST=
# That file [BLUEWATCH_CACHE_DIR/ideas_shared.jsonl]
BLUEWATCH_IDEAS_PERSIST_PATH=

# --- Names
# Product name the API reports [BlueWatch]
BLUEWATCH_PRODUCT_NAME=
# Name of the weekly shortlist [Now Surfacing]
BLUEWATCH_LIST_NAME=

# --- Outreach (the public app never sends e-mail; leave these empty on a public server)
# "demo" may send only to OUTREACH_ALLOWLIST (never in public mode); any other value turns sending off [demo]
OUTREACH_MODE=
# Comma-separated addresses a private demo may send to [none]
OUTREACH_ALLOWLIST=
# SMTP server for a private demo [none; port 587]
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# The sending organisation shown in every draft [the workspace's: A'Pelago or Redstone]. Its business ID,
# address and privacy notice are used only with a named sender; until then the draft says they come later.
OUTREACH_SENDER_ORG=
OUTREACH_SENDER_BUSINESS_ID=
OUTREACH_SENDER_ADDRESS=
# Where a STOP reply goes [the first OUTREACH_ALLOWLIST address, else none: the draft asks for a reply]
OUTREACH_STOP_ADDRESS=
# Privacy notice linked from every draft [none]
OUTREACH_PRIVACY_URL=

# --- Deployment (read by deploy/compose.yml and deploy/compose.port.yml, not by the app)
# Public hostname [bluewatch.demo.wicflow.com]
BLUEWATCH_HOST=
# Traefik's Docker network, entrypoint and certificate resolver [n8n_default / websecure / zerossl]
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=
TRAEFIK_CERTRESOLVER=
# Loopback port for compose.port.yml behind a host proxy [18787]
BLUEWATCH_PORT=

# Uvicorn trusts X-Forwarded-For only from these addresses [*]. On a shared Docker network set it to the reverse
# proxy's address or subnet (e.g. Traefik's container IP), or other containers can spoof visitor IPs.
FORWARDED_ALLOW_IPS=
